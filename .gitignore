# Ignore editor and IDE settings
.idea/
.vscode/
.cursor/
.claude/
.cache/
.sync*

# Ignore log files
*.log

# Ignore temporary files
tmp/
*.tar.gz

# Ignore build and distribution directories
backup/
bin/
x-ui/
dist/
!internal/web/dist/
internal/web/dist/*
!internal/web/dist/.gitkeep
release/
node_modules/

# Ignore compiled binaries
main

# Ignore OS specific files
.DS_Store
Thumbs.db

# Ignore Go build files
*.exe
x-ui.db
x-ui.db-shm
x-ui.db-wal
system_metrics.gob
*.dump

# Ignore Docker specific files
docker-compose.override.yml

# Ignore local environment, credentials, TLS material, and database backups.
# Keep only intentionally non-sensitive templates in the repository.
.env
.env.*
!.env.example
!*.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.kdb
*.keystore
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.bak
*.backup
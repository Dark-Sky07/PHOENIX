+package trojan
+
+import (
+	"net"
+
+	"github.com/xtls/xray-core/common/protocol"
+)
+
+// trackedUserConnection holds the exact authenticated transport. It is not
+// a count of substreams, a persistent epoch, or proof that traffic was flushed.
+type trackedUserConnection struct{ connection net.Conn }
+
+func (h *Server) trackUserConnection(user *protocol.MemoryUser, conn net.Conn) (func(), bool) {
+	if user == nil || conn == nil {
+		return nil, false
+	}
+	// Users without email cannot be addressed by RemoveUser. Preserve upstream
+	// behavior, but never claim this experimental facility covers them.
+	if user.Email == "" {
+		return func() {}, true
+	}
+	h.userSessionMu.Lock()
+	defer h.userSessionMu.Unlock()
+	if h.validator.GetByEmail(user.Email) != user {
+		return nil, false
+	}
+	if h.userSessions == nil {
+		h.userSessions = make(map[*protocol.MemoryUser]map[*trackedUserConnection]struct{})
+	}
+	if h.userSessions[user] == nil {
+		h.userSessions[user] = make(map[*trackedUserConnection]struct{})
+	}
+	entry := &trackedUserConnection{connection: conn}
+	h.userSessions[user][entry] = struct{}{}
+	return func() {
+		h.userSessionMu.Lock()
+		defer h.userSessionMu.Unlock()
+		delete(h.userSessions[user], entry)
+		if len(h.userSessions[user]) == 0 {
+			delete(h.userSessions, user)
+		}
+	}, true
+}

+func (i *MultiUserInbound) trackPhoenixUser(user *protocol.MemoryUser, conn io.Closer) (func(), bool) {
+	if user == nil || conn == nil {
+		return nil, false
+	}
+	i.Lock()
+	defer i.Unlock()
+	found := false
+	for _, u := range i.users {
+		if u == user {

+		}
+	}
+	if !found {
+		return nil, false
+	}
+	if i.sessions == nil {
+		i.sessions = make(map[*protocol.MemoryUser]map[*phoenixSession]struct{})
+	}
+	if i.sessions[user] == nil {
+		i.sessions[user] = make(map[*phoenixSession]struct{})
+	}
+	entry := &phoenixSession{connection: conn}
+	i.sessions[user][entry] = struct{}{}
+	return func() {
+		i.Lock()
+		defer i.Unlock()
+		delete(i.sessions[user], entry)
+		if len(i.sessions[user]) == 0 {
+			delete(i.sessions, user)
+		}
+	}, true

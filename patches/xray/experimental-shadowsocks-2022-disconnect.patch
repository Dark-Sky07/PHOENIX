@@ -0,0 +1,112 @@
+package shadowsocks_2022
+
+import (
+	"context"
+	"encoding/base64"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-shadowsocks/shadowaead_2022"
+	"github.com/xtls/xray-core/common/protocol"
+)
+
+func phoenixUser(email, key string) *protocol.MemoryUser {
+	return &protocol.MemoryUser{Email: email, Account: &MemoryAccount{Key: key}}
+}
+func phoenixServer(t *testing.T) (*MultiUserInbound, string) {
+	t.Helper()
+	i := &MultiUserInbound{}
+	key := base64.StdEncoding.EncodeToString([]byte("0123456789abcdef"))
+	service, err := shadowaead_2022.NewMultiService[*protocol.MemoryUser]("2022-blake3-aes-128-gcm", []byte("fedcba9876543210"), 500, i, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	i.service = service
+	return i, key
+}
+func TestPhoenixSS2022RemovalAndStableIdentity(t *testing.T) {
+	i, key := phoenixServer(t)
+	a, b := phoenixUser("a@test", key), phoenixUser("b@test", base64.StdEncoding.EncodeToString([]byte("abcdefghijklmnop")))
+	if err := i.AddUser(context.Background(), a); err != nil {
+		t.Fatal(err)
+	}
+	if err := i.AddUser(context.Background(), b); err != nil {
+		t.Fatal(err)
+	}
+	ac, ap := net.Pipe()
+	defer ap.Close()
+	bc, bp := net.Pipe()
+	defer bc.Close()
+	defer bp.Close()
+	doneA, ok := i.trackPhoenixUser(a, ac)
+	if !ok {
+		t.Fatal("failed to track a")
+	}
+	defer doneA()
+	doneB, ok := i.trackPhoenixUser(b, bc)
+	if !ok {
+		t.Fatal("failed to track b")
+	}
+	defer doneB()
+	if err := i.RemoveUser(context.Background(), a.Email); err != nil {
+		t.Fatal(err)
+	}
+	_ = ap.SetReadDeadline(time.Now().Add(time.Second))
+	var byteBuf [1]byte
+	if _, err := ap.Read(byteBuf[:]); err != io.EOF {
+		t.Fatalf("removed session remains active: %v", err)
+	}
+	_ = bp.SetReadDeadline(time.Now().Add(20 * time.Millisecond))
+	if _, err := bp.Read(byteBuf[:]); err == nil {
+		t.Fatal("unexpected data")
+	} else if n, ok := err.(net.Error); !ok || !n.Timeout() {
+		t.Fatalf("other session closed: %v", err)
+	}
+	if i.GetUser(context.Background(), b.Email) != b {
+		t.Fatal("remaining identity changed after removal")
+	}
+	if err := i.AddUser(context.Background(), phoenixUser(a.Email, key)); err != nil {
+		t.Fatal(err)
+	}
+	c, p := net.Pipe()
+	defer c.Close()
+	defer p.Close()
+	if _, ok := i.trackPhoenixUser(a, c); ok {
+		t.Fatal("accepted stale identity")
+	}
+	bad := phoenixUser("bad@test", "not-base64!")
+	if err := i.AddUser(context.Background(), bad); err == nil {
+		t.Fatal("invalid key accepted")
+	}
+	if i.GetUser(context.Background(), bad.Email) != nil {
+		t.Fatal("failed update published invalid user")
+	}
+}
+func TestPhoenixSS2022RegistrationRemovalRace(t *testing.T) {
+	for n := 0; n < 100; n++ {
+		i, key := phoenixServer(t)
+		user := phoenixUser("a@test", key)
+		if err := i.AddUser(context.Background(), user); err != nil {
+			t.Fatal(err)
+		}
+		c, p := net.Pipe()
+		var wg sync.WaitGroup
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			if done, ok := i.trackPhoenixUser(user, c); ok {
+				defer done()
+				_ = c.SetReadDeadline(time.Now().Add(time.Second))
+				var b [1]byte
+				_, _ = c.Read(b[:])
+			}
+		}()
+		go func() { defer wg.Done(); _ = i.RemoveUser(context.Background(), user.Email) }()
+		wg.Wait()
+		_ = c.Close()
+		_ = p.Close()
+	}
+}

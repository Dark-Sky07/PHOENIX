+package inbound
+
+import (
+	"context"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/uuid"
+	"github.com/xtls/xray-core/proxy/vless"
+)
+
+func testPhoenixUser(email string) *protocol.MemoryUser {
+	id := uuid.New()
+	return &protocol.MemoryUser{Email: email, Account: &vless.MemoryAccount{ID: protocol.NewID(id)}}
+}
+
+func TestPhoenixVlessRemovalClosesOnlyRemovedUserAndRejectsStaleAuthentication(t *testing.T) {
+	h := &Handler{validator: new(vless.MemoryValidator)}
+	a, b := testPhoenixUser("a@test"), testPhoenixUser("b@test")
+	for _, u := range []*protocol.MemoryUser{a, b} {
+		if err := h.AddUser(context.Background(), u); err != nil {
+			t.Fatal(err)
+		}
+	}
+	aConn, aPeer := net.Pipe()
+	defer aPeer.Close()
+	bConn, bPeer := net.Pipe()
+	defer bConn.Close()
+	defer bPeer.Close()
+	doneA, ok := h.trackUserConnection(a, aConn)
+	if !ok {
+		t.Fatal("failed tracking a")
+	}
+	defer doneA()
+	second, secondPeer := net.Pipe()
+	defer secondPeer.Close()
+	doneSecond, ok := h.trackUserConnection(a, second)
+	if !ok {
+		t.Fatal("failed tracking second a session")
+	}
+	defer doneSecond()
+	doneB, ok := h.trackUserConnection(b, bConn)
+	if !ok {
+		t.Fatal("failed tracking b")
+	}
+	defer doneB()
+	removed := make(chan error, 1)
+	go func() { removed <- h.RemoveUser(context.Background(), "a@test") }()
+	_ = aPeer.SetReadDeadline(time.Now().Add(time.Second))
+	var buf [1]byte
+	if _, err := aPeer.Read(buf[:]); err != io.EOF {
+		t.Fatalf("removed session remains open: %v", err)
+	}
+	_ = secondPeer.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := secondPeer.Read(buf[:]); err != io.EOF {
+		t.Fatalf("second removed session remains open: %v", err)
+	}
+	// Closing transports alone must not complete the handler-scope barrier.
+	select {
+	case err := <-removed:
+		t.Fatalf("removal completed before handlers returned: %v", err)
+	default:
+	}
+	doneA()
+	doneSecond()
+	if err := <-removed; err != nil {
+		t.Fatal(err)
+	}
+	_ = bPeer.SetReadDeadline(time.Now().Add(25 * time.Millisecond))
+	if _, err := bPeer.Read(buf[:]); err == nil {
+		t.Fatal("unexpected data")
+	} else if nerr, ok := err.(net.Error); !ok || !nerr.Timeout() {
+		t.Fatalf("other user's session closed: %v", err)
+	}
+	// Re-adding the email does not admit a connection authenticated against
+	// the old user object before it was removed.
+	replacement := testPhoenixUser("a@test")
+	if err := h.AddUser(context.Background(), replacement); err != nil {
+		t.Fatal(err)
+	}
+	stale, stalePeer := net.Pipe()
+	defer stale.Close()
+	defer stalePeer.Close()
+	if _, ok := h.trackUserConnection(a, stale); ok {
+		t.Fatal("stale authentication accepted")
+	}
+}
+
+func TestPhoenixVlessRemovalRacesWithConnectionRegistration(t *testing.T) {
+	for round := 0; round < 100; round++ {
+		h := &Handler{validator: new(vless.MemoryValidator)}
+		u := testPhoenixUser("race@test")
+		if err := h.AddUser(context.Background(), u); err != nil {
+			t.Fatal(err)
+		}
+		conn, peer := net.Pipe()
+		var wg sync.WaitGroup
+		wg.Add(2)
+		go func() {
+			defer wg.Done()
+			if untrack, ok := h.trackUserConnection(u, conn); ok {
+				defer untrack()
+				_ = conn.SetReadDeadline(time.Now().Add(time.Second))
+				var b [1]byte
+				_, _ = conn.Read(b[:])
+			}
+		}()
+		go func() { defer wg.Done(); _ = h.RemoveUser(context.Background(), u.Email) }()
+		wg.Wait()
+		_ = conn.Close()
+		_ = peer.Close()
+		check, checkPeer := net.Pipe()
+		if _, ok := h.trackUserConnection(u, check); ok {
+			t.Fatal("removed user admitted")
+		}
+		_ = check.Close()
+		_ = checkPeer.Close()
+	}
+}
+
+func TestPhoenixVlessBarrierTimeoutDoesNotClaimSuccess(t *testing.T) {
+	h := &Handler{validator: new(vless.MemoryValidator)}
+	u := testPhoenixUser("timeout@test")
+	if err := h.AddUser(context.Background(), u); err != nil {
+		t.Fatal(err)
+	}
+	conn, peer := net.Pipe()
+	defer peer.Close()
+	done, ok := h.trackUserConnection(u, conn)
+	if !ok {
+		t.Fatal("track failed")
+	}
+	defer done()
+	ctx, cancel := context.WithTimeout(context.Background(), 25*time.Millisecond)
+	defer cancel()
+	if err := h.RemoveUser(ctx, u.Email); err == nil {
+		t.Fatal("unfinished handler reported as removed")
+	}
+	if h.validator.GetByEmail(u.Email) != nil {
+		t.Fatal("user was re-enabled after timeout")
+	}
+}
